QMainWindow {
    background: #f5f5f5;
}

#header {
    background: #ffffff;
    border-bottom: 1px solid #dddddd;
}

#applicationTitle {
    font-size: 20px;
    font-weight: bold;
}

#leftPanel,
#rightPanel {
    background: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 8px;
}

#imageViewer {
    background: #fafafa;
    border: 1px solid #dddddd;
    border-radius: 8px;
}

QPushButton {
    padding: 8px 12px;
    border: 1px solid #cccccc;
    border-radius: 6px;
    background: #ffffff;
}

QPushButton:hover {
    background: #eeeeee;
}

QPushButton:checked {
    background: #dddddd;
    font-weight: bold;
}

QPushButton:disabled {
    color: #999999;
    background: #eeeeee;
}

QComboBox {
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    background: #ffffff;
    color: #222222;
}

QComboBox:hover {
    border: 1px solid #999999;
}

QComboBox:focus {
    border: 1px solid #777777;
}

QComboBox::drop-down {
    width: 36px;
    border: none;
    background: transparent;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 10px;
    padding: 6px;
    outline: none;
    selection-background-color: #eeeeee;
    selection-color: #111111;
}

QComboBox QAbstractItemView::item {
    min-height: 38px;
    padding: 8px 12px;
    border-radius: 6px;
}

QComboBox QAbstractItemView::item:hover {
    background: #f0f0f0;
}

QComboBox QAbstractItemView::item:selected {
    background: #e8e8e8;
    color: #111111;
}

QToolBar {
    background: #ffffff;
    border-bottom: 1px solid #dddddd;
    spacing: 6px;
}

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #dddddd;
}
